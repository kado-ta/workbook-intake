{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__xlide_.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/probe.sh\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/probe.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
