{
  "mcpServers": {
    "xlide": {
      "command": "uvx",
      "args": [
        "--no-config",
        "--from", "xlide-mcp==1.2.4",
        "--with", "pyopenvba==6.6.0",
        "--with", "pyofficeeditor==0.4.1",
        "--with", "pyvbaanalysis==3.0.3",
        "--with", "mcp==2.3.0",
        "xlide-mcp", "--root", "${WORKBOOK_INTAKE_DIR:-~/workbook-intake}", "--read-only"
      ],
      "env": {
        "XLIDE_MCP_ALLOW_OUTSIDE_ROOTS": "0"
      }
    }
  }
}
