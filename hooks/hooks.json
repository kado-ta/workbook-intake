{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__xlide_.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-xlide.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/record-consent.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
